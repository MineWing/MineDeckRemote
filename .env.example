# Required only to choose the first admin password. Without it, MineDeck prints a random one once.
MINEDECK_PASSWORD=replace-with-at-least-12-characters
MINEDECK_HOST=0.0.0.0
MINEDECK_PORT=8787

# Optional HTTPS (recommended on untrusted networks)
# MINEDECK_TLS_CERT=/absolute/path/to/cert.pem
# MINEDECK_TLS_KEY=/absolute/path/to/key.pem
